{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.0.0/tooling/cli/schema.json",
  "productName": "Praelector",
  "version": "0.1.0",
  "identifier": "com.praelector.app",
  "build": {
    "beforeDevCommand": "pnpm -F ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -F ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Praelector",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
