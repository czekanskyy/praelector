{
  "$defs": {
    "AudioSettings": {
      "description": "Global audio output (TTS-05, TTS-08).\n\nApplied at concat time, so changing these never invalidates rendered chunks\n(DATA_MODEL.md §9.2).",
      "properties": {
        "crossfade_ms": {
          "default": 0,
          "maximum": 2000,
          "minimum": 0,
          "title": "Crossfade Ms",
          "type": "integer"
        },
        "inter_sentence_silence_ms": {
          "default": 300,
          "maximum": 5000,
          "minimum": 0,
          "title": "Inter Sentence Silence Ms",
          "type": "integer"
        },
        "output_bitrate_kbps": {
          "default": 64,
          "maximum": 320,
          "minimum": 16,
          "title": "Output Bitrate Kbps",
          "type": "integer"
        },
        "output_sample_rate": {
          "default": 44100,
          "maximum": 192000,
          "minimum": 8000,
          "title": "Output Sample Rate",
          "type": "integer"
        },
        "target_lufs": {
          "default": -23.0,
          "maximum": -5.0,
          "minimum": -70.0,
          "title": "Target Lufs",
          "type": "number"
        }
      },
      "title": "AudioSettings",
      "type": "object"
    },
    "GpuPolicy": {
      "description": "User overrides for the GPU-04 budget math; the formula supplies defaults.",
      "properties": {
        "allow_cpu": {
          "default": true,
          "title": "Allow Cpu",
          "type": "boolean"
        },
        "device_index": {
          "default": 0,
          "minimum": -1,
          "title": "Device Index",
          "type": "integer"
        },
        "peak_worker_mib_overrides": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Peak Worker Mib Overrides",
          "type": "object"
        },
        "reserve_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserve Mib"
        },
        "worker_cap": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Worker Cap",
          "type": "integer"
        }
      },
      "title": "GpuPolicy",
      "type": "object"
    },
    "PathSettings": {
      "description": "Explicit binary and directory overrides. ``None`` means \"resolve it\".",
      "properties": {
        "calibre_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibre Path"
        },
        "ffmpeg_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg Path"
        },
        "models_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Models Dir"
        },
        "projects_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projects Dir"
        }
      },
      "title": "PathSettings",
      "type": "object"
    }
  },
  "description": "The whole settings tree, as served by ``GET /v1/settings``.",
  "properties": {
    "audio": {
      "$ref": "#/$defs/AudioSettings"
    },
    "gpu": {
      "$ref": "#/$defs/GpuPolicy"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "log_level": {
      "default": "INFO",
      "title": "Log Level",
      "type": "string"
    },
    "paths": {
      "$ref": "#/$defs/PathSettings"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "Settings",
  "type": "object"
}
